# Modèle du fichier .env : copie-le en .env (même dossier) et remplis-le.
#
# .env est ignoré par git : ce qui s'y trouve ne part jamais sur GitHub.
# .env.example, lui, EST versionné -- n'y mets jamais une vraie clé.
#
# Tous les scripts lisent .env au démarrage (env_local.py), d'où qu'ils soient
# lancés : terminal, éditeur, tâche planifiée. Une variable déjà définie dans
# l'environnement (setx, $env:...) l'emporte sur ce fichier.

# --- SEC (04, 04b, 04c, 07b) : obligatoire, un contact réel
SEC_CONTACT_EMAIL=ton.adresse@exemple.fr

# --- LLM (02, 04c, 07b) : Gemini prioritaire, Mistral en repli
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# MISTRAL_API_KEY=
# LLM_PROVIDER=gemini
# MISTRAL_REQUESTS_PER_SECOND=1

# --- Alpha Vantage (08 --av-backfill-dates) : optionnel
# ALPHAVANTAGE_API_KEY=

# --- IB Gateway (restart_gateway.py) : lus par ce seul script
IB_USERNAME=
IB_PASSWORD=
IB_TRADING_MODE=paper
IBC_PATH=
IB_GATEWAY_PORT=4002
